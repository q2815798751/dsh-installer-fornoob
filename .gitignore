# build artifacts
dist/
launcher/dist/
installer/dist/
launcher/data/
launcher/test/
__pycache__/
*.pyc
*.pyo
# 自检聚合入口的机器可读汇总
selfcheck.json

# 备份护栏的落地目录（scripts\backup-dsh-registry.py 生成）
scripts/backups/

# PyInstaller work dirs — keep the .spec files (source), drop the rest
launcher/build/*
installer/build/*
!launcher/build/*.spec
!installer/build/*.spec

# install payload (regenerated by scripts\build.ps1)
payload/
testhome*/
testhome2/
*.log

# generated from launcher.pyw's VERSION by scripts/make-version-info.py
installer/_version.py

# python/pnpm
.pnpm-store/
node_modules/

# build-time icon proof sheet (regenerated by make-icon.py)
launcher/icon-preview.png
